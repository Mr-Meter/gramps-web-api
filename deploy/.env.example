# docker compose settings for Gramps Web ("Tree" fork).
# Copy to .env (cp .env.example .env) and edit.
# Format: KEY=value, no spaces around "=", comments only on separate lines.
# If a value contains "$", double it ($$) or put the value in single quotes.
# The .env file holds secrets - do not commit it.

# ===== Site =====

# Name of the family tree. Created on first start if it does not exist yet.
# Do not use a purely numeric name: it would be read as a number.
GRAMPSWEB_TREE=Tree

# Host port the site is served on (always 5000 inside the container).
# Behind a reverse proxy (nginx, Caddy) use e.g. 8080.
GRAMPSWEB_PORT=80

# REQUIRED: the public address of the site as users see it
# (with scheme; no trailing slash). It ends up in e-mail links:
# e-mail confirmation, password reset and succession notifications
# (<BASE_URL>/settings/succession). With a wrong address the links will not open.
GRAMPSWEB_BASE_URL=http://localhost

# Flask secret key (signs the login tokens). Empty value: the key is
# generated on first start and stored in the gramps_secret volume.
# Safer to set it explicitly, e.g. the output of  openssl rand -base64 32
GRAMPSWEB_SECRET_KEY=

# ===== Succession (fork feature) =====

# How often (in seconds) the web app checks the succession plans.
# The check runs on requests to the site, at most once per interval.
# 0 disables the check in the web app.
GRAMPSWEB_SUCCESSION_CHECK_INTERVAL=600

# Period (in seconds) of the background check in the grampsweb_succession service:
# a safety net in case nobody visits the site for a long time.
SUCCESSION_CHECK_EVERY=3600

# ===== Outgoing e-mail (SMTP) =====
# Without e-mail, no messages are sent for e-mail confirmation, password reset
# and succession notifications (including confirmation requests); the plans
# themselves still advance on the timer.

# SMTP server address and port.
GRAMPSWEB_EMAIL_HOST=localhost
GRAMPSWEB_EMAIL_PORT=465

# SMTP credentials (leave empty if no authentication is needed).
GRAMPSWEB_EMAIL_HOST_USER=
GRAMPSWEB_EMAIL_HOST_PASSWORD=

# Encryption; values strictly true/false in lower case:
#   port 465 (SMTPS):          USE_SSL=true   USE_STARTTLS=false
#   port 587 (STARTTLS):       USE_SSL=false  USE_STARTTLS=true
#   port 25, no encryption:    USE_SSL=false  USE_STARTTLS=false
GRAMPSWEB_EMAIL_USE_SSL=true
GRAMPSWEB_EMAIL_USE_STARTTLS=false

# Sender address. While it is empty, e-mail counts as not configured.
GRAMPSWEB_DEFAULT_FROM_EMAIL=

# ===== Performance =====

# Number of gunicorn worker processes (web server). The image defaults to 8;
# 2-4 are enough for a small server; each process uses a noticeable amount of memory.
GUNICORN_NUM_WORKERS=4
